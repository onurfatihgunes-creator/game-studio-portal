# ── Supabase (Project Settings → API) ─────────────────────────────
# Both values are safe for the browser. The portal never needs the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── GitHub App (server-side only; never prefix these with NEXT_PUBLIC_) ──
# Create the app as described in README.md → "Create the GitHub App".
GITHUB_APP_ID=123456
# The app's URL slug (github.com/apps/<slug>), used for the "Install on more repositories" link.
GITHUB_APP_SLUG=your-game-portal
# Private key (.pem). Either paste it with literal \n for newlines, or base64-encode the whole file:
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# ── Optional: Master Game PM integration boundary ─────────────────
# If set, game pages show a link to the matching project in Master Game PM.
# The portal only builds links; it never reads from or writes to the PM project.
MASTER_PM_BASE_URL=

# ── Optional: GitHub Enterprise Server ────────────────────────────
# Defaults to https://api.github.com
GITHUB_API_URL=

# ── Optional: AdMob revenue reporting (read-only) ─────────────────
# Google Cloud Console → enable the AdMob API → OAuth consent screen → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <your portal origin>/api/integrations/admob/callback
#   e.g. http://localhost:3000/api/integrations/admob/callback  and  https://YOUR-DOMAIN/api/integrations/admob/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts the stored refresh token (AES-256-GCM). Generate once:  openssl rand -base64 32   — keep it server-side only.
ADMOB_TOKEN_ENCRYPTION_KEY=

# ── Apply to All Games: where the shared Unity ads module lives (server-side only) ──
# The private repository that holds Packages/com.studio.ads, and the tag to roll out (a reviewed version).
ADS_MODULE_REPO=owner/unity-ci
ADS_MODULE_REF=ads-v0.4.0
